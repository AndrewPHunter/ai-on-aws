{
  "realm": "lab",
  "displayName": "AI on AWS lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      {
        "name": "desk",
        "description": "Enters inquiries and runs the intake agents and the orchestrator."
      },
      {
        "name": "medical-information",
        "description": "Does what the desk does, and runs the label expert."
      },
      {
        "name": "safety-reviewer",
        "description": "Reads adverse event cases and decides them."
      },
      {
        "name": "auditor",
        "description": "Reads every case and its audit trail, and every run's trace in the client; changes nothing."
      },
      {
        "name": "evaluation",
        "description": "Held only by the evaluation harness's service account."
      },
      {
        "name": "knowledge-gate",
        "description": "Held only by the knowledge gate's service account."
      },
      {
        "name": "contact-form",
        "description": "Held only by the contact form's service account."
      },
      {
        "name": "lab-explorer",
        "description": "Held only by the lab explorer's service account."
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for add all basic claims to the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {"introspection.token.claim": "true", "access.token.claim": "true"}
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "agents:intake",
      "description": "Runs the intake agents (POST /invocations on intake-handwritten and intake-strands).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience intake-handwritten",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "intake-handwritten",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience intake-strands",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "intake-strands",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "agents:expert",
      "description": "Runs the label expert (POST /invocations on expert).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience expert",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "expert",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "agents:expert:delegated",
      "description": "Runs the label expert for a person, through the orchestrator only (POST /invocations on expert).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience expert",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "expert",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "agents:orchestrator",
      "description": "Runs the orchestrator (POST /invocations on orchestrator).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience orchestrator",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "orchestrator",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "cases:write",
      "description": "Creates a case and adds a follow-up in the case system (create_case, add_follow_up).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience case-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "case-system",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "cases:lookup",
      "description": "Finds a case in the case system (find_case).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience case-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "case-system",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "cases:read",
      "description": "Reads cases in the case system (GET /cases, GET /cases/<id>).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience case-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "case-system",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "cases:review",
      "description": "Decides a case in the case system (POST /cases/<id>/review).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience case-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "case-system",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "labels:search",
      "description": "Searches the retrieval service (find_labels, search_label).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience knowledge",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "knowledge",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "traces:read",
      "description": "Reads every run's trace, steps included, in the client (GET /api/traces, GET /api/traces/<run_id>).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "agents:intake",
      "roles": ["desk", "medical-information", "contact-form", "lab-explorer"]
    },
    {
      "clientScope": "agents:expert",
      "roles": ["medical-information", "evaluation", "lab-explorer"]
    },
    {
      "clientScope": "agents:expert:delegated",
      "roles": ["desk", "medical-information", "contact-form", "lab-explorer"]
    },
    {
      "clientScope": "agents:orchestrator",
      "roles": ["desk", "medical-information", "contact-form", "lab-explorer"]
    },
    {
      "clientScope": "cases:write",
      "roles": ["desk", "medical-information", "contact-form", "lab-explorer"]
    },
    {
      "clientScope": "cases:read",
      "roles": ["safety-reviewer", "auditor"]
    },
    {
      "clientScope": "cases:review",
      "roles": ["safety-reviewer"]
    },
    {
      "clientScope": "labels:search",
      "roles": ["desk", "medical-information", "evaluation", "knowledge-gate", "contact-form", "lab-explorer"]
    },
    {
      "clientScope": "traces:read",
      "roles": ["auditor"]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "profile", "email"],
  "defaultOptionalClientScopes": [],

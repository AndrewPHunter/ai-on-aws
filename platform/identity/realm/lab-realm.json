{
  "realm": "lab",
  "displayName": "AI on AWS lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      { "name": "reviewer", "description": "May review adverse event cases." }
    ]
  },
  "clients": [
    {
      "clientId": "desk",
      "name": "Medical information desk",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${IDENTITY_DESK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "bearerOnly": false,
      "consentRequired": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "standard.token.exchange.enabled": "false"
      },
      "defaultClientScopes": ["basic", "profile", "email"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience lab-agents",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lab-agents",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience lab-case-system",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lab-case-system",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience lab-knowledge",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lab-knowledge",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "client_id",
            "claim.value": "desk",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f01",
      "username": "riley.reviewer",
      "enabled": true,
      "firstName": "Riley",
      "lastName": "Reviewer",
      "email": "riley.reviewer@example.org",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "${IDENTITY_RILEY_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["default-roles-lab", "reviewer"]
    },
    {
      "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f02",
      "username": "dana.desk",
      "enabled": true,
      "firstName": "Dana",
      "lastName": "Desk",
      "email": "dana.desk@example.org",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        { "type": "password", "value": "${IDENTITY_DANA_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["default-roles-lab"]
    }
  ]
}

# Secrets for the identity provider. platform/identity/setup.sh writes platform/identity/.env with a value for
# each of these: a random one for the administrator and each client secret, and each person's username as that
# person's password (the people are synthetic, the lab is local, and their passwords are typed by hand).
# .env is ignored by git, never commit it. Write it by hand only if you must, and then give every variable a value.

# Keycloak's bootstrap administrator, for the admin console at http://localhost:8090/admin/.
IDENTITY_ADMIN_USERNAME=
IDENTITY_ADMIN_PASSWORD=

# The secret of the client desk, which the desk's server sends when it exchanges a code or refreshes a token.
IDENTITY_DESK_CLIENT_SECRET=

# The secrets of the agents' clients, which each agent sends when it exchanges the caller's token for a token
# for a service or agent it calls: the two intake agents, the label expert and the orchestrator.
IDENTITY_INTAKE_HANDWRITTEN_CLIENT_SECRET=
IDENTITY_INTAKE_STRANDS_CLIENT_SECRET=
IDENTITY_EXPERT_CLIENT_SECRET=
IDENTITY_ORCHESTRATOR_CLIENT_SECRET=

# The secrets of the four machine callers' clients, which each sends to obtain a token by client credentials:
# the evaluation harness (client evaluation), the knowledge gate (client knowledge-gate), and, inside the client's
# server, the contact form (client contact-form) and the lab explorer (client lab-explorer).
IDENTITY_EVALUATION_CLIENT_SECRET=
IDENTITY_KNOWLEDGE_GATE_CLIENT_SECRET=
IDENTITY_CONTACT_FORM_CLIENT_SECRET=
IDENTITY_LAB_EXPLORER_CLIENT_SECRET=

# The password of the realm user riley.reviewer (holds the safety-reviewer role); setup.sh sets it to riley.reviewer.
IDENTITY_RILEY_PASSWORD=

# The password of the realm user dana.desk (holds the desk role); setup.sh sets it to dana.desk.
IDENTITY_DANA_PASSWORD=

# The password of the realm user morgan.medinfo (holds the medical-information role); setup.sh sets it to morgan.medinfo.
IDENTITY_MORGAN_PASSWORD=

# The password of the realm user avery.auditor (holds the auditor role); setup.sh sets it to avery.auditor.
IDENTITY_AVERY_PASSWORD=

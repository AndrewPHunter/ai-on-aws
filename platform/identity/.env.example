# Secrets for the identity provider. platform/identity/setup.sh writes platform/identity/.env with a random
# value for each of these; .env is ignored by git, never commit it. Write it by hand only if you must, and
# then give every variable a value.

# Keycloak's bootstrap administrator, for the admin console at http://localhost:8090/admin/.
IDENTITY_ADMIN_USERNAME=
IDENTITY_ADMIN_PASSWORD=

# The secret of the client desk, which the desk's server sends when it exchanges a code or refreshes a token.
IDENTITY_DESK_CLIENT_SECRET=

# The secrets of the agents' clients, which each agent sends when it exchanges the caller's token for a token
# for a service or agent it calls: the two intake agents, the label expert and the orchestrator.
IDENTITY_INTAKE_HANDWRITTEN_CLIENT_SECRET=
IDENTITY_INTAKE_STRANDS_CLIENT_SECRET=
IDENTITY_EXPERT_CLIENT_SECRET=
IDENTITY_ORCHESTRATOR_CLIENT_SECRET=

# The secrets of the two machine callers' clients, which each sends to obtain a token by client credentials:
# the evaluation harness (client evaluation) and the knowledge gate (client knowledge-gate).
IDENTITY_EVALUATION_CLIENT_SECRET=
IDENTITY_KNOWLEDGE_GATE_CLIENT_SECRET=

# The password of the realm user riley.reviewer (holds the safety-reviewer role).
IDENTITY_RILEY_PASSWORD=

# The password of the realm user dana.desk (holds the desk role).
IDENTITY_DANA_PASSWORD=

# The password of the realm user morgan.medinfo (holds the medical-information role).
IDENTITY_MORGAN_PASSWORD=

# The password of the realm user avery.auditor (holds the auditor role).
IDENTITY_AVERY_PASSWORD=

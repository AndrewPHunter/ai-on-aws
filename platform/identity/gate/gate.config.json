{
  "issuer": "http://localhost:8090/realms/lab",
  "clientId": "desk",
  "clientSecretVariable": "IDENTITY_DESK_CLIENT_SECRET",
  "redirectUri": "http://localhost:3000/auth/callback",
  "lifetimeSeconds": 600,
  "requestTimeoutMs": 15000,
  "scopes": {
    "agents:intake": ["intake-handwritten", "intake-strands"],
    "agents:expert": ["expert"],
    "agents:expert:delegated": ["expert"],
    "agents:orchestrator": ["orchestrator"],
    "cases:write": ["case-system"],
    "cases:lookup": ["case-system"],
    "cases:read": ["case-system"],
    "cases:review": ["case-system"],
    "labels:search": ["knowledge"]
  },
  "deskScopes": ["agents:intake", "agents:expert", "agents:orchestrator", "cases:read", "cases:review"],
  "deskForbiddenScopes": ["labels:search", "agents:expert:delegated"],
  "staffRoles": ["desk", "medical-information", "safety-reviewer", "auditor"],
  "machineRoles": ["evaluation", "knowledge-gate"],
  "users": [
    { "username": "dana.desk", "passwordVariable": "IDENTITY_DANA_PASSWORD", "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f02", "staffRole": "desk", "granted": ["agents:intake", "agents:orchestrator"] },
    { "username": "morgan.medinfo", "passwordVariable": "IDENTITY_MORGAN_PASSWORD", "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f03", "staffRole": "medical-information", "granted": ["agents:intake", "agents:expert", "agents:orchestrator"] },
    { "username": "riley.reviewer", "passwordVariable": "IDENTITY_RILEY_PASSWORD", "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f01", "staffRole": "safety-reviewer", "granted": ["cases:read", "cases:review"] },
    { "username": "avery.auditor", "passwordVariable": "IDENTITY_AVERY_PASSWORD", "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f04", "staffRole": "auditor", "granted": ["cases:read"] }
  ],
  "agents": [
    { "clientId": "intake-handwritten", "secretVariable": "IDENTITY_INTAKE_HANDWRITTEN_CLIENT_SECRET", "audience": "case-system", "scopes": ["cases:write", "cases:lookup"], "subject": { "username": "dana.desk", "scope": "agents:intake" } },
    { "clientId": "intake-strands", "secretVariable": "IDENTITY_INTAKE_STRANDS_CLIENT_SECRET", "audience": "case-system", "scopes": ["cases:write", "cases:lookup"], "subject": { "username": "dana.desk", "scope": "agents:intake" } },
    { "clientId": "expert", "secretVariable": "IDENTITY_EXPERT_CLIENT_SECRET", "audience": "knowledge", "scopes": ["labels:search"], "subject": { "username": "morgan.medinfo", "scope": "agents:expert" } }
  ],
  "orchestrator": {
    "clientId": "orchestrator",
    "secretVariable": "IDENTITY_ORCHESTRATOR_CLIENT_SECRET",
    "scope": "agents:orchestrator",
    "callers": ["dana.desk", "morgan.medinfo"],
    "delegations": [
      { "audience": "intake-strands", "scope": "agents:intake", "onlyThisClient": false },
      { "audience": "expert", "scope": "agents:expert:delegated", "onlyThisClient": true }
    ],
    "forbiddenScopes": ["labels:search", "agents:expert"]
  },
  "machines": [
    { "clientId": "evaluation", "secretVariable": "IDENTITY_EVALUATION_CLIENT_SECRET", "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f05", "role": "evaluation", "scope": "agents:expert", "forbiddenScopes": ["labels:search", "agents:expert:delegated"] },
    { "clientId": "knowledge-gate", "secretVariable": "IDENTITY_KNOWLEDGE_GATE_CLIENT_SECRET", "id": "6b1f0c2e-5a3d-4e8f-9b71-2c4d8e0a1f06", "role": "knowledge-gate", "scope": "labels:search", "forbiddenScopes": ["agents:expert:delegated"] }
  ],
  "audienceOnlyClients": ["case-system", "knowledge"],
  "exchangeOffDescription": "Standard token exchange is not enabled for the requested client"
}

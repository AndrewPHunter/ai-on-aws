{
  "name": "ai-on-aws",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p client/web/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test \"**/test/*.test.ts\"",
    "build:web": "vite build --config client/web/vite.config.ts --configLoader native",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:web -- --outDir /tmp/web-dist --emptyOutDir"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@strands-agents/sdk": "1.25.0",
    "@xmldom/xmldom": "0.9.12",
    "bedrock-agentcore": "0.4.6",
    "jose": "6.2.18",
    "openid-client": "6.8.9",
    "openai": "6.49.0",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "@aws-sdk/client-bedrock-agentcore": "3.1174.0",
    "@aws-sdk/client-bedrock-agentcore-control": "3.1174.0",
    "@aws-sdk/credential-provider-cognito-identity": "3.972.83",
    "@aws-sdk/credential-providers": "3.1174.0",
    "@aws-sdk/util-endpoints": "3.996.57"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@tanstack/react-query": "5.108.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}

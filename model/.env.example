# Machine-specific settings for the model server.
# Copy this file to .env and fill it in. .env is ignored by git; never commit it.

# Address on the GPU host to publish the servers on:
# its LAN address to serve other machines, or 127.0.0.1 for same-machine use only.
MODEL_BIND_ADDRESS=
# Ports of the chat, embedding and reranker servers; all three must differ.
MODEL_PORT=8000
MODEL_EMBED_PORT=8001
MODEL_RERANK_PORT=8002

# Directory on the GPU host where model weights are stored (tens of GiB).
MODEL_CACHE_DIR=

# User and group id on the GPU host that will own the downloaded files (id -u, id -g).
MODEL_RUN_UID=
MODEL_RUN_GID=

# Shared secret that clients send as a bearer token, to all three servers. Generate one with: openssl rand -hex 24
MODEL_API_KEY=

# How clients reach each server: http://<address>:<port>/v1, with that server's port
MODEL_BASE_URL=
MODEL_EMBED_BASE_URL=
MODEL_RERANK_BASE_URL=

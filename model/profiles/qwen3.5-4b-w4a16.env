# Qwen3.5-4B with 4-bit weights (W4A16), about 5.1 GiB of weights.
# Status: measured 2026-11-19 on an RTX 3090 Ti (24 GiB), vLLM v0.34.0. Gate passed (one run).
#   vLLM at start-up: context cache of 133,152 tokens, enough for 4.06 requests of 32,768 tokens at once.
#   GPU memory in use: 10,378 MiB at start-up, 10,780 MiB at peak during the gate.
#   Gate (gate/gate.config.json): 80 of 80 tool-calling conversations correct at 4 at a time,
#   no server faults, 4 simultaneous prompts of about 14,600 tokens each answered correctly.
# Changed 2026-11-21: CHAT_EXTRA_ARGS gives --gpu-memory-utilization 0.05.
#   Beside the embedding and reranker servers (retrieval.env), a chat container restarted on its own
#   exited: vLLM found 18.62 of 23.55 GiB free at start-up, less than its default fraction of 0.92 (21.66 GiB).
#   With the cache fixed in bytes the fraction sizes nothing; it is only vLLM's start-up check.
#   That failure, and the restart that then worked (healthy in about 50 s beside the other two, same cache),
#   were measured with the large tier's profile (qwen3.5-9b-w4a16), not with this one.

# Name clients use for the model
MODEL_ID=qwen3.5-4b

CHAT_MODEL_REPO=RedHatAI/Qwen3.5-4B-quantized.w4a16
CHAT_MODEL_REVISION=7a613872f394578b0b52b683ff4ac47516b4bcaf

# Longest single request (prompt plus reply), in tokens
CHAT_MAX_MODEL_LEN=32768
# Requests processed at the same time; more than this queue
CHAT_MAX_NUM_SEQS=4
# Size of the context cache in bytes (4.5 GiB): room for 4 requests of 32,768 tokens.
# The server fails at start-up if this does not fit; it never shrinks the cache.
CHAT_KV_CACHE_BYTES=4831838208
CHAT_KV_CACHE_DTYPE=auto

CHAT_TOOL_CALL_PARSER=qwen3_coder
CHAT_REASONING_PARSER=qwen3
CHAT_EXTRA_ARGS=--gpu-memory-utilization 0.05

# Qwen3.5-4B converted to MLX with 4-bit weights, served by vLLM-Metal on an Apple silicon Mac: the chat profile
# of the Metal tier (model/metal/tiers.json), read by model/metal/servers.sh, setup and the gate.
# vLLM-Metal reports its cache as "CPU KV cache size", where vLLM on an NVIDIA card reports "GPU KV cache size".

# Name clients use for the model
MODEL_ID=qwen3.5-4b

CHAT_MODEL_REPO=mlx-community/Qwen3.5-4B-4bit
CHAT_MODEL_REVISION=0e7ffd5c629ef7719d4cbc04069232580bfa9d9c

# Longest single request (prompt plus reply), in tokens
CHAT_MAX_MODEL_LEN=32768
# Requests processed at the same time; more than this queue
CHAT_MAX_NUM_SEQS=4
# Size of the context cache in bytes (4.5 GiB): room for 4 requests of 32,768 tokens.
# The server fails at start-up if this does not fit; it never shrinks the cache.
CHAT_KV_CACHE_BYTES=4831838208
# Start-up share of memory, given explicitly (as the embedding and reranker servers' are, in
# model/metal/retrieval.env) so that vLLM's default, 0.92, is never the one in force. The cache is the size
# CHAT_KV_CACHE_BYTES gives.
CHAT_GPU_MEMORY_UTILIZATION=0.30

CHAT_TOOL_CALL_PARSER=qwen3_coder
CHAT_REASONING_PARSER=qwen3

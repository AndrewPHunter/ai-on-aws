# Qwen3.5-4B with 4-bit weights (W4A16), about 5.1 GiB of weights, with a shorter context to fit smaller cards.
# A context cache of 82,895 tokens, enough for 4.05 requests of 20,480 tokens at once, and 9,232 MiB of GPU
# memory at peak under the gate, the figure model/tiers.json holds for the small tier. Both figures are from
# a 24 GiB card, not from a card of the size this profile is for.
# CHAT_EXTRA_ARGS gives --gpu-memory-utilization 0.05: the share of the card vLLM checks is free at start-up,
# small enough to be free beside the embedding and reranker servers (retrieval.env). vLLM's default, 0.92, is
# not free while they run. With the cache fixed in bytes the share sizes nothing.

# Name clients use for the model
MODEL_ID=qwen3.5-4b

CHAT_MODEL_REPO=RedHatAI/Qwen3.5-4B-quantized.w4a16
CHAT_MODEL_REVISION=7a613872f394578b0b52b683ff4ac47516b4bcaf

# Longest single request (prompt plus reply), in tokens
CHAT_MAX_MODEL_LEN=20480
# Requests processed at the same time; more than this queue
CHAT_MAX_NUM_SEQS=4
# Size of the context cache in bytes (3 GiB): room for 4 requests of 20,480 tokens.
# The server fails at start-up if this does not fit; it never shrinks the cache.
CHAT_KV_CACHE_BYTES=3221225472
CHAT_KV_CACHE_DTYPE=auto

CHAT_TOOL_CALL_PARSER=qwen3_coder
CHAT_REASONING_PARSER=qwen3
CHAT_EXTRA_ARGS=--gpu-memory-utilization 0.05

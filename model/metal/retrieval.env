# The embedding model and the reranker that run beside the Metal chat tier, one vLLM-Metal process each, on an
# Apple silicon Mac. The same variable names as model/retrieval.env, read by model/metal/servers.sh, setup and
# the gate, and by the lab's retrieval service when model/.env names this file (MODEL_RETRIEVAL_ENV).
#
# Embedding (Qwen3-Embedding-0.6B): the same repository, revision, served name, dimensions and longest input as
# model/retrieval.env, so an index built with either toolchain is searched with the other. An input over the limit
# is refused, never truncated.
# Reranker (Qwen3-Reranker-0.6B, converted to MLX with 8-bit weights): vLLM-Metal serves it as a sequence
# classifier scoring the tokens "no" and "yes", with the overrides and the prompt template below. vLLM-Metal does not
# serve bge-reranker-v2-m3, the reranker of model/retrieval.env. /v1/rerank takes query and documents and returns
# results [{index, relevance_score}], best first.
# With a context cache of 1 GiB each, the embedding server and the reranker each hold 9,360 tokens, room for 1.14
# inputs of 8,192 tokens at once (their start-up capacity lines on an Apple M3 Max with 128 GB).
#
# Both run with VLLM_ENABLE_V1_MULTIPROCESSING=0, vLLM-Metal's way to run a pooling server (servers.sh sets it).
# Each cache is the size its bytes give. Each server is also given its start-up share of memory explicitly (0.10
# here, 0.30 for the chat server in its profile), so that vLLM's default, 0.92, is never the one in force.

# Embedding model
EMBED_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B
EMBED_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
# Name clients use for the model
EMBED_MODEL_ID=qwen3-embedding-0.6b
# Longest single input, in tokens. Longer inputs are refused, not truncated.
EMBED_MAX_MODEL_LEN=8192
# Size of the context cache in bytes (1 GiB): 9,360 tokens (see above).
EMBED_KV_CACHE_BYTES=1073741824
# Start-up share of memory, given explicitly (see above)
EMBED_GPU_MEMORY_UTILIZATION=0.10
# Numbers in each vector the server returns
EMBED_DIMENSIONS=1024

# Reranker
RERANK_MODEL_REPO=mku64/Qwen3-Reranker-0.6B-mlx-8Bit
RERANK_MODEL_REVISION=ba80418a47fa1c4368a6c2287b0e449904063576
# Name clients use for the model
RERANK_MODEL_ID=qwen3-reranker-0.6b
# Longest input, in tokens
RERANK_MAX_MODEL_LEN=8192
# Size of the context cache in bytes (1 GiB): 9,360 tokens (see above).
RERANK_KV_CACHE_BYTES=1073741824
# Start-up share of memory, given explicitly (see above)
RERANK_GPU_MEMORY_UTILIZATION=0.10
# vLLM's --hf-overrides: load the model as a classifier from its "no" and "yes" tokens
RERANK_HF_OVERRIDES={"architectures":["Qwen3ForSequenceClassification"],"classifier_from_token":["no","yes"],"is_original_qwen3_reranker":true}
# vLLM's --chat-template, a path under model/: the prompt the reranker was trained with (see model/README.md)
RERANK_CHAT_TEMPLATE=metal/qwen3_reranker.jinja

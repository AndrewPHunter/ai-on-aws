# The embedding model and the reranker that run beside every chat tier, one vLLM process each.
# Their settings are the same on every tier. Passed as a third --env-file wherever a profile is passed.
#
# Embedding (Qwen3-Embedding-0.6B): a context cache of 9,344 tokens, enough for 1.14 inputs of 8,192 tokens at
# once. 2,964 MiB of GPU memory at peak under the gate, the figure model/tiers.json holds. An input over the
# limit is refused, never truncated; a batch holding one is refused as a whole; a "dimensions" field is refused.
# Reranker (bge-reranker-v2-m3): 1,882 MiB of GPU memory at peak with 20 of the corpus's largest passages in
# one request, the figure model/tiers.json holds; the gate's smaller requests reach 1,702 MiB. /v1/rerank takes
# query and documents and returns results [{index, relevance_score}], best first.
# Both figures are from an RTX 3090 Ti (24 GiB) beside the large chat tier. Both servers answer 401 to no key
# and to a wrong key.
#
# With --kv-cache-memory-bytes set, vLLM still refuses to start unless the free GPU memory is at least
# --gpu-memory-utilization times the card's total (default 0.92). Whenever another of the lab's three
# servers is running that much is not free, so each of the three gives the fraction: 0.05 here, and the
# same in each profile's CHAT_EXTRA_ARGS. It sizes nothing while the cache is fixed in bytes.

# Embedding model
EMBED_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B
EMBED_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
# Name clients use for the model
EMBED_MODEL_ID=qwen3-embedding-0.6b
# Longest single input, in tokens. Longer inputs are refused, not truncated.
EMBED_MAX_MODEL_LEN=8192
# Size of the context cache in bytes (1 GiB): room for one input of 8,192 tokens.
EMBED_KV_CACHE_BYTES=1073741824
# Fraction of the card's memory that must be free at start-up (see above)
EMBED_GPU_MEMORY_UTILIZATION=0.05
# Numbers in each vector the server returns
EMBED_DIMENSIONS=1024

# Reranker
RERANK_MODEL_REPO=BAAI/bge-reranker-v2-m3
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# Name clients use for the model
RERANK_MODEL_ID=bge-reranker-v2-m3
# Longest input, in tokens. A longer document is refused unless max_tokens_per_doc is sent.
RERANK_MAX_MODEL_LEN=8192
# Size of the context cache in bytes (256 MiB)
RERANK_KV_CACHE_BYTES=268435456
# Fraction of the card's memory that must be free at start-up (see above)
RERANK_GPU_MEMORY_UTILIZATION=0.05
